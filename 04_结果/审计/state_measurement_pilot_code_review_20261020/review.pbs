#!/bin/bash
#PBS -N state_review
#PBS -q rqdf
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
cd /lstr/sahara/minlpml/junyu/state_measurement_pilot_20261020_v2
exec > "${REVIEW_ROOT:?required}/review_${PBS_JOBID}.log" 2>&1
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export PYTHONUNBUFFERED=1
exec /lstr/sahara/minlpml/junyu/paper3_raw_replay_20261015/.venv/bin/python scripts/review_state_measurement_artifacts.py \
  --protocol experiments/state_measurement_pilot_20261020/protocol.json \
  --base /lstr/sahara/minlpml/junyu/state_measurement_pilot_20261020_v2/results \
  --output "${REVIEW_ROOT}/results"

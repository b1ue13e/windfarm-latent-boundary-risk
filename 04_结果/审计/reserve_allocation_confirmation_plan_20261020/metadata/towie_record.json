ttps://zenodo.org/api/records/22662930/files/2026.zip/content"}}, {"id": "21872094-828b-4de8-a9e6-47b8d18b4540", "key": "turbine_fastlog.zip", "size": 11925990240, "checksum": "md5:483acf28d7a901faf5eac611412e1a1f", "links": {"self": "https://zenodo.org/api/records/22662930/files/turbine_fastlog.zip/content"}}, {"id": "5c354ff7-b6b2-4168-ae7e-b13d12264e53", "key": "ZXMS-RES035-REP01-01.pdf", "size": 1483553, "checksum": "md5:dd453d6fa084af36b96b068e924e3bd4", "links": {"self": "https://zenodo.org/api/records/22662930/files/ZXMS-RES035-REP01-01.pdf/content"}}, {"id": "be646d96-7d96-41f5-be90-c989098a3c85", "key": "ZXMS-RES029-REP01-01.pdf", "size": 1271423, "checksum": "md5:ba41ddba4d685faf32e4907357b7f2b5", "links": {"self": "https://zenodo.org/api/records/22662930/files/ZXMS-RES029-REP01-01.pdf/content"}}, {"id": "dcc976fe-0262-4f06-9d73-11be3398b14c", "key": "T21_weather_sensors.jpg", "size": 3586480, "checksum": "md5:9a221cf569cbbd7cc2d6259724bca957", "links": {"self": "https://zenodo.org/api/records/22662930/files/T21_weather_sensors.jpg/content"}}, {"id": "b7adfd23-2bdc-40eb-8a75-fe846e350957", "key": "CHANGELOG.md", "size": 2996, "checksum": "md5:7f3e2e71bed47e52f71032d7b8fb83c0", "links": {"self": "https://zenodo.org/api/records/22662930/files/CHANGELOG.md/content"}}, {"id": "321999e2-db0e-42b8-a2d9-d5f04f7250d1", "key": "README.md", "size": 5930, "checksum": "md5:567004f1e3f81b3ad81f397272dc31b0", "links": {"self": "https://zenodo.org/api/records/22662930/files/README.md/content"}}], "swh": {}, "owners": [{"id": "1266150"}], "status": "published", "stats": {"downloads": 53140, "unique_downloads": 20529, "views": 11505, "unique_views": 10309, "version_downloads": 22407, "version_unique_downloads": 3552, "version_unique_views": 979, "version_views": 1154}, "state": "done", "submitted": true}